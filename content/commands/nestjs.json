[
  {
    "id": "nestjs-install-cli",
    "framework": "nestjs",
    "title": "Install the Nest CLI",
    "command": "npm install -g @nestjs/cli",
    "description": "Installs the nest command globally.",
    "tags": ["setup", "global"],
    "source": "https://docs.nestjs.com/cli/overview",
    "verified": "2026-11"
  },
  {
    "id": "nestjs-new",
    "framework": "nestjs",
    "title": "Create a Nest project",
    "command": "nest new {{name}}",
    "description": "Creates and initializes a new Nest project.",
    "vars": [
      {
        "key": "name",
        "default": "api",
        "label": "Project name"
      }
    ],
    "flags": [
      {
        "flag": "-p pnpm",
        "desc": "Use pnpm"
      },
      {
        "flag": "--skip-git",
        "desc": "Don't init git"
      },
      {
        "flag": "--skip-install",
        "desc": "Don't install packages"
      },
      {
        "flag": "--dry-run",
        "desc": "Preview without writing files"
      }
    ],
    "tags": ["setup", "scaffold"],
    "source": "https://docs.nestjs.com/cli/usages",
    "verified": "2026-11"
  },
  {
    "id": "nestjs-start-dev",
    "framework": "nestjs",
    "title": "Start in watch mode",
    "command": "npm run start:dev",
    "description": "Runs the app and reloads on changes (nest start --watch).",
    "tags": ["run"],
    "source": "https://docs.nestjs.com/cli/usages",
    "verified": "2026-11"
  },
  {
    "id": "nestjs-start-debug",
    "framework": "nestjs",
    "title": "Start with the debugger",
    "command": "nest start --debug --watch",
    "description": "Runs with --inspect and live reload.",
    "tags": ["run", "debug"],
    "source": "https://docs.nestjs.com/cli/usages",
    "verified": "2026-11"
  },
  {
    "id": "nestjs-build",
    "framework": "nestjs",
    "title": "Build the project",
    "command": "nest build",
    "description": "Compiles the app into dist/.",
    "flags": [
      {
        "flag": "-b swc",
        "desc": "Faster builds with SWC"
      }
    ],
    "tags": ["build"],
    "source": "https://docs.nestjs.com/cli/usages",
    "verified": "2026-11"
  },
  {
    "id": "nestjs-g-resource",
    "framework": "nestjs",
    "title": "Generate a CRUD resource",
    "command": "nest g resource {{name}}",
    "description": "Generates module, controller, service, DTOs and entity in one go.",
    "vars": [
      {
        "key": "name",
        "default": "users",
        "label": "Name"
      }
    ],
    "flags": [
      {
        "flag": "--no-spec",
        "desc": "Skip the test file"
      },
      {
        "flag": "--flat",
        "desc": "Don't create a folder"
      },
      {
        "flag": "--dry-run",
        "desc": "Preview without writing files"
      }
    ],
    "tags": ["generate"],
    "source": "https://docs.nestjs.com/cli/usages",
    "verified": "2026-11"
  },
