{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command.schema.json",
  "title": "Command list",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "framework",
      "title",
      "command",
      "description",
      "tags",
      "source",
      "verified"
    ],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "framework": { "type": "string" },
      "title": { "type": "string", "maxLength": 80 },
      "command": { "type": "string" },
      "description": { "type": "string", "maxLength": 160 },
      "vars": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key", "default"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string" },
            "default": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      },
      "flags": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["flag", "desc"],
          "additionalProperties": false,
          "properties": { "flag": { "type": "string" }, "desc": { "type": "string" } }
        }
      },
      "platforms": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "windows": { "type": "string" }, "macos": { "type": "string" } }
      },
      "tags": { "type": "array", "items": { "type": "string" } },
      "danger": { "type": "boolean" },
      "source": { "type": "string", "format": "uri" },
      "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
    }
  }
}
