{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Khaleds Dev Kit",
  "version": "1.0.0",
  "identifier": "com.khaled.devkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Khaled's Dev Kit",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "'self' http: https:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Khaled",
    "copyright": "© 2026 Khaled",
    "category": "DeveloperTool",
    "shortDescription": "Offline toolbox for web developers",
    "longDescription": "Commands, formatters, converters, CSS and design tools, GSAP snippets, responsive tools, database tools, page templates and your own snippet library — in one offline desktop app.",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzRjI3RDM2OUM4QzgxNjUKUldSbGdZeWNObjN5MDN3Y25HWjhtTmxUeGFVeE9MWWNZTWtXSDFGUlpvbmtpaXlCZXZnMVdhb2cK",
      "endpoints": [
        "https://github.com/khaledalazzeh2006/khaleds-dev-kit/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
